{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-in",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Nur /api/* und die Sitemap laufen durch den Worker, alles andere kommt direkt aus den Static Assets
    "run_worker_first": ["/api/*", "/sitemap.xml"]
  }
  // Secrets (MOBILE_API_USER, MOBILE_API_PASSWORD, MOBILE_CUSTOMER_NUMBER)
  // werden NICHT hier eingetragen, sondern im Cloudflare-Dashboard bzw. lokal in .dev.vars
}
